{
  "name": "team-gopal-singh-app",
  "version": "1.0.0",
  "private": true,
  "description": "Team Gopal Singh civic service platform for Assembly Constituency 198 Jhalrapatan",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "client:install": "npm install --prefix client",
    "client:build": "npm run build --prefix client",
    "install:all": "npm install && npm run client:install",
    "build": "npm run client:build",
    "setup": "npm run install:all && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}
